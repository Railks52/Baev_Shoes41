<Window x:Class="Baev_Shoes41.OrderWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Оформление заказа" Height="600" Width="800" FontFamily="Comic Sans MS" Icon="/Res/icon.ico">
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Шапка заказа -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="200"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="30"/>
            </Grid.RowDefinitions>

            <TextBlock Text="Дата формирования заказа:" Grid.Row="0" VerticalAlignment="Center"/>
            <DatePicker Name="OrderDP" Grid.Row="0" Grid.Column="1" IsEnabled="False"/>

            <TextBlock Text="Дата доставки заказа:" Grid.Row="1" VerticalAlignment="Center"/>
            <DatePicker Name="DeliveryDP" Grid.Row="1" Grid.Column="1" IsEnabled="False"/>

            <TextBlock Text="ФИО клиента:" Grid.Row="2" VerticalAlignment="Center"/>
            <TextBlock Name="ClientTB" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold"/>

            <TextBlock Text="Номер заказа:" Grid.Row="3" VerticalAlignment="Center"/>
            <TextBlock Name="TBOrderID" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" FontWeight="Bold"/>
        </Grid>

        <!-- Список товаров в заказе -->
        <ListView Name="ShoeListView" Grid.Row="1">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="450"/>
                            <ColumnDefinition Width="120"/>
                        </Grid.ColumnDefinitions>

                        <Image Grid.Column="0" Width="100" Stretch="Uniform"  HorizontalAlignment="Center">
                            <Image.Source>
                                <Binding Path="ProductIMG">
                                    <Binding.TargetNullValue>
                                        <ImageSource>
                                            /Res/picture.png
                                        </ImageSource>
                                    </Binding.TargetNullValue>
                                </Binding>
                            </Image.Source>
                        </Image>

                        <StackPanel Grid.Column="1" Margin="10,0">
                            <TextBlock Text="{Binding ProductName}" FontSize="16"/>
                            <TextBlock Text="{Binding ProductDescription}" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding Manufacturer.ManufacturerName}"/>
                            <TextBlock Text="{Binding ProductCost, StringFormat={}{0} рублей}"/>

                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                <Button Name="BtnMinus" Content="-" Width="25" Height="25" Click="BtnMinus_Click"/>
                                <TextBlock Text="{Binding Quantity}" Margin="10,0" VerticalAlignment="Center" FontSize="16"/>
                                <Button Name="BtnPlus" Content="+" Width="25" Height="25" Click="BtnPlus_Click"/>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Center">
                            <TextBlock Text="Скидка"/>
                            <TextBlock Text="{Binding ProductDiscountAmount, StringFormat={}{0} %}" FontSize="20"/>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Пункт выдачи и итоговая сумма -->
        <StackPanel Grid.Row="2" Margin="0,10">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                <TextBlock Text="Пункт выдачи:" Width="200" VerticalAlignment="Center"/>
                <ComboBox Name="PickupCombo" Width="400" DisplayMemberPath="FullAddress"/>
            </StackPanel>

            <StackPanel Orientation="Horizontal">
                <TextBlock Name="TotalSumTB" FontSize="16" FontWeight="Bold" Margin="0,0,30,0"/>
                <TextBlock Name="TotalDiscountTB" FontSize="16" Foreground="Green" FontWeight="Bold"/>
            </StackPanel>
        </StackPanel>

        <!-- Кнопка сохранения -->
        <Button Name="SaveBtn" Content="Сохранить" Grid.Row="3" Width="200" Height="35" Click="SaveBtn_Click"/>
    </Grid>
</Window>


