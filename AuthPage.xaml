<Page x:Class="Baev_Shoes41.AuthPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
      xmlns:local="clr-namespace:Baev_Shoes41"
      mc:Ignorable="d" 
      d:DesignHeight="450" d:DesignWidth="800"
      Title="AuthPage" FontFamily="Comic Sans MS">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <TextBlock Text="Логин" FontSize="20" Margin="0,0,50,25"
                   VerticalAlignment="Bottom"  HorizontalAlignment="Right"></TextBlock>
        <TextBlock Text="Пароль" FontSize="20" Margin="0,25,50,0"
           VerticalAlignment="Top"  HorizontalAlignment="Right"
                   Grid.Row="1"></TextBlock>

        <TextBox Name="LoginTB" TextChanged="LoginTB_TextChanged"
                 VerticalAlignment="Bottom" HorizontalAlignment="Left"
                 Width="300" Height="25" Grid.Column="1" Margin="-10,0,0,25"></TextBox>

        <TextBox Name="PasswordTB" TextChanged="PasswordTB_TextChanged"
         VerticalAlignment="Top" HorizontalAlignment="Left"
         Width="300" Height="25" Margin="-10,25,0,0"
                 Grid.Column="1" Grid.Row="1" ></TextBox>

        <Button Content="Войти как гость" Name="LogGHBtn" Click="LogGHBtn_Click"
                Grid.Row="2" Margin="100,0,0,0" Height="30"></Button>
        
        <Button Content="Войти" Name="LogUsBtn" Click="LogUsBtn_Click"
        Grid.Row="2" Grid.Column="1" Margin="0,0,100,0"
                Height="30"></Button>

        <StackPanel Orientation="Horizontal" Grid.Row="2" Grid.Column="1" Name="CaptchaPanel" Margin="0,-30,0,0">
            <TextBlock Name="captchaOneWord" FontSize="22" Margin="30,0,0,0"></TextBlock>
            <TextBlock Name="captchaTwoWord" FontSize="22" TextDecorations="Strikethrough" Margin="0,5,0,0"></TextBlock>
            <TextBlock Name="captchaThreeWord" FontSize="22" TextDecorations="Strikethrough"></TextBlock>
            <TextBlock Name="captchaFourWord" FontSize="22" TextDecorations="Strikethrough" Margin="0,10,0,0"></TextBlock>
        </StackPanel>
        <TextBox Name="CaptchaInputTB" Width="150" Height="25" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Bottom"  Grid.Row="1"/>
    </Grid>
</Page>
